{% doc %}
  A/B engine of the bundle offer (rendered by ob-offer, inline, before the versions so there is no flicker).
  - Picks the visitor's version of the product's running test by its traffic split, keeps it in localStorage (obab).
  - ?ab=<test>:<version> forces a version for this page view (preview, never counted).
  - ?ob=<bundle id> shows a preview bundle instead of the offer (looks only, never counted).
  - Writes the cart attribute _obab ("test:version") so the discount function charges the version shown and orders
    carry it (the editor reads it back for the results).
  - Optional stats: when cfg.collector is set, sends one "view" per test and session and one "atc" per add to cart.
  @param {object} cfg - open_bundles.config.
  @param {string} [test_id] - Running test on this product.
  @param {object} [versions] - Its versions [[key, bundle id]].
{% enddoc %}
{%- liquid
  assign split = cfg.tests[test_id]
-%}
<script>
(function () {
  var h = document.documentElement, q = new URLSearchParams(location.search), C = {{ cfg.collector | default: '' | json }};
  var pv = q.get('ob') || '';
  if (/^[a-z0-9][a-z0-9-]{0,60}$/.test(pv)) h.classList.add('ob-pv-on', 'ob-pv-' + pv);
  {%- if test_id != blank %}
  var T = {{ test_id | json }}, V = [{% for v in versions %}[{{ v[0] | json }}, {{ split[v[0]] | default: 50 }}]{% unless forloop.last %},{% endunless %}{% endfor %}];
  var keys = V.map(function (x) { return x[0]; }), ls = {}, f = '', preview = !!pv;
  try { ls = JSON.parse(localStorage.getItem('obab') || '{}') || {}; } catch (e) {}
  (q.get('ab') || '').split(',').forEach(function (p) { var x = p.split(':'); if (x[0] === T) f = x[1]; });
  var v = ls[T];
  if (keys.indexOf(f) > -1) { v = f; preview = true; }
  else if (keys.indexOf(v) < 0) {
    var tot = 0, r, i;
    for (i = 0; i < V.length; i++) tot += V[i][1];
    r = Math.random() * tot; v = keys[0];
    for (i = 0; i < V.length; i++) { r -= V[i][1]; if (r < 0) { v = V[i][0]; break; } }
    ls[T] = v;
  }
  if (!ls._vid) ls._vid = Math.random().toString(36).slice(2, 14);
  try { localStorage.setItem('obab', JSON.stringify(ls)); } catch (e) {}
  h.classList.add('obab-' + T + '-' + v);
  var attr = T + ':' + v;
  var beacon = function (e) {
    if (preview || !C || !navigator.sendBeacon) return;
    try { navigator.sendBeacon(C, JSON.stringify({ vid: ls._vid, e: e, t: [[T, v]], p: location.pathname })); } catch (err) {}
  };
  var seen = {};
  try { seen = JSON.parse(sessionStorage.getItem('obab_seen') || '{}') || {}; } catch (e) {}
  if (!seen[T]) { beacon('view'); seen[T] = 1; try { sessionStorage.setItem('obab_seen', JSON.stringify(seen)); } catch (e) {} }
  var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
  var setAttr = function () {
    return fetch(root + 'cart/update.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ attributes: { _obab: attr } }) });
  };
  if (window.fetch && !window.__obabFetch) {
    window.__obabFetch = 1;
    var of = window.fetch;
    window.fetch = function (input) {
      var u = typeof input === 'string' ? input : (input && input.url) || '';
      var p = of.apply(this, arguments);
      if (u.indexOf('/cart/add') > -1) p.then(function (res) { if (res.ok) { beacon('atc'); setAttr(); } }).catch(function () {});
      return p;
    };
  }
  addEventListener('load', function () {
    fetch(root + 'cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); })
      .then(function (cart) { if ((cart.attributes || {})._obab !== attr) setAttr(); }).catch(function () {});
  });
  {%- endif %}
})();
</script>
