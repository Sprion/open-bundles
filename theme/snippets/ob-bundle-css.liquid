{% doc %}
  Styles of the ob-bundle components. Each design (classic = Rows, cards, boxed, pack) is a preset:
  default values of CSS variables named like the bundle's style keys (--text, --border, --accent, --title_size…,
  the same names as the editor preview), plus the few structural rules of that design. The bundle's style overrides
  any variable for its own block (.ob-<bid>). The base rules are printed once per page.
  @param {string} bid - Block id.
  @param {object} [st] - Bundle style (colours #rrggbb, sizes in px, weights).
  @param {string} [css] - Bundle custom CSS.
  @param {boolean} [hide_compare] - Hide the struck prices.
{% enddoc %}
{%- liquid
  assign px = ',rows_hint_x,thumb_cap_lh,thumb_stack_x,thumb_stack_y,mix_name_size,rows_hint_top,rows_gap,sw_radius,sw_pad,tag_radius,tag_pad_y,tag_pad_x,tag_size,rows_color_w,rows_indent,gift_img,gift_title_size,gift_name_size,ship_size,note_size,custom_size,chips_gap,sub_chip_size,price_strike_gap,cta_radius,badge_pad_in,dot_size,dot_border,link_size,bar_pad_b,chips_pad,gift_top,gift_pad,rows_num_w,rows_size_w,rows_col_gap,chip_pad_y,chip_pad_x,chip_radius,chip_size,chip_top,thumb_cap_size,free_pad_y,free_pad_x,rows_hint_size,dd_h,rows_num_size,rows_free_size,rows_label_size,dd_radius,dd_size,dd_swatch,pill_lh,pill_pad,mix_badge_radius,size_btn_w,badge_ring_w,pill_h,pill_title_size,pill_sub_size,badge_left,size_btn_h,size_head_size,mix_w,mix_h,mix_gap,mix_badge_size,cta_h,cta_size,unitp_size,totals_size,deal_size,deal_radius,deal_pad_y,deal_pad_x,badge_ear,save_pad_y,save_pad_x,save_radius,save_size,save_gap,hl_gap,hl_top,hl_size,hl_icon,plus_size,thumb_gap,ship_halo,radius,spacing,block_title_size,title_size,subtitle_size,price_size,label_size,badge_size,unit_size,swatch_size,thumb_size,sel_border,strike_size,bar_pad_y,bar_pad_x,badge_radius,badge_pad_x,badge_top,gift_size,gift_note_size,ladder_title_size,ladder_item_size,ladder_pic,row_height,row_gap,badge_space,title_lh,unit_lh,unit_gap,price_lh,strike_lh,price_gap,badge_pad_y,badge_lh,badge_right,thumb_h,edge,'
  assign skip = ',mix_pic,badge_style,subtitle_style,swatch_shape,banner_style,price_layout,gift_style,button_price,ship_style,tracking,font,badge_case,mix_label,dot_style,tag_case,chip_case,cta_case,sw_ratio,dd_caret,rows_free_style,ship_position,size_label,banner_look,il_size_pos,custom_style,'
-%}
<style>
  .ob.ob-{{ bid }} { {%- for pair in st -%}{%- capture k -%},{{ pair[0] }},{%- endcapture -%}{%- unless skip contains k -%}--{{ pair[0] }}:{{ pair[1] }}{% if px contains k %}px{% endif %};{%- endunless -%}{%- endfor -%} }
  {%- comment -%} Fine metrics (px), only when the bundle sets them: line heights, gaps, badge box, thumbnail height. {%- endcomment -%}
  {%- assign b0 = '.ob.ob-' | append: bid -%}
  {%- if st.title_lh %} {{ b0 }} .ob__title { line-height:{{ st.title_lh }}px; }{% endif -%}
  {%- if st.unit_lh or st.unit_gap %} {{ b0 }} .ob__unit { {% if st.unit_lh %}line-height:{{ st.unit_lh }}px;{% endif %}{% if st.unit_gap %}margin-top:{{ st.unit_gap }}px;{% endif %} }{% endif -%}
  {%- if st.price_lh %} {{ b0 }} .ob__now { line-height:{{ st.price_lh }}px; }{% endif -%}
  {%- if st.strike_lh %} {{ b0 }} .ob__was { line-height:{{ st.strike_lh }}px; }{% endif -%}
  {%- if st.price_gap %} {{ b0 }} .ob__price { gap:{{ st.price_gap }}px; }{% endif -%}
  {%- if st.badge_pad_y != nil %} {{ b0 }} .ob__badge { padding-top:{{ st.badge_pad_y }}px; padding-bottom:{{ st.badge_pad_y }}px; line-height:{{ st.badge_lh | default: 15 }}px; }{% endif -%}
  {%- if st.badge_right != nil %} {{ b0 }} .ob__badge:not(.ob__badge--inline):not(.ob__badge--ribbon):not(.ob__badge--tab) { right:{{ st.badge_right }}px; }{% endif -%}
  {%- if st.edge %} {{ b0 }} { margin-left:-{{ st.edge }}px; margin-right:-{{ st.edge }}px; }{% endif -%}
  {%- if st.thumb_h %} {{ b0 }} .ob__ts img { height:{{ st.thumb_h }}px; }{% endif -%}
  {%- if st.thumb_stack_x != nil or st.thumb_stack_y != nil %} {{ b0 }} .ob__ts img + img { margin-left:calc(var(--thumb_size, 40px) * -1 + {{ st.thumb_stack_x | default: 0 }}px); margin-top:{{ st.thumb_stack_y | default: 0 }}px; }{% endif -%}
  {%- if st.sub_lh %} {{ b0 }} .ob__sub { line-height:{{ st.sub_lh }}px; }{% endif -%}
  {%- if st.rows_color_w %} {{ b0 }} .ob__rowitem--lab { grid-template-columns:var(--rows_num_w, 30px) minmax({{ st.rows_color_w }}px, max-content) var(--rows_size_w, 96px); }{% endif -%}
  {%- if hide_compare %} .ob-{{ bid }} .ob__was, .ob-{{ bid }} [data-ob-swas] { display:none !important; }{% endif %}
  {{ css }}
</style>
<style data-ob-base>
  /* presets: variable defaults (same values as the editor PRESETS) */
  .ob { --text:#1b1b1b; --muted:#646464; --cards_bg:#ffffff; --selected_bg:#f7f7f7; --border:#e2e2e2; --accent:#111111; --block_title_color:#1b1b1b;
    --title_color:#1b1b1b; --subtitle_color:#5e5e5e; --price_color:#1b1b1b; --strike:#7a7a7a; --tag_bg:#111111; --tag_text:#ffffff; --badge_bg:#c4c4c4;
    --badge_text:#1b1b1b; --save_bg:#eeeeee; --button:#111111; --button_text:#ffffff; --gift_bg:#eeeeee; --gift_text:#1b1b1b;
    --radius:5px; --spacing:8px; --block_title_size:14px; --title_size:14px; --subtitle_size:12px; --price_size:16px; --label_size:10px; --badge_size:10px;
    --unit_size:12px; --swatch_size:38px; --block_title_weight:500; --title_weight:600; --subtitle_weight:400; --label_weight:600; --badge_weight:700; --unit_weight:400;
    --timer_bg:#1b1b1b; --timer_text:#ffffff; --timer_accent:#c4c4c4; --highlight_text:inherit; --highlight_icon:#676767; --ladder_bg:#ffffff; --ladder_text:#1b1b1b;
    --ladder_accent:#606060; --link_color:inherit; --deal_bg:#606060; --deal_text_color:#ffffff; --unit_price_color:#5f5f5f;
    position:relative; margin:4px 0 0; color:var(--text); font-family:inherit; }
  .ob--cards { --border:#d8d8d8; --price_color:#535353; --radius:8px; --spacing:14px; --title_size:16px; --price_size:20px; --swatch_size:64px; }
  .ob--boxed { --selected_bg:#f5f5f5; --border:#dadada; --accent:#1b1b1b; --subtitle_color:#111111; --strike:#606060; --tag_bg:#ececec; --tag_text:#111111;
    --badge_bg:#1b1b1b; --badge_text:#ffffff; --radius:6px; --spacing:10px; --block_title_size:16px; --title_size:16px; --subtitle_size:14px; --price_size:17px;
    --label_size:11px; --badge_size:11px; --unit_size:13px; --swatch_size:32px; --title_weight:500; --subtitle_weight:500; --badge_weight:600;
    font-family:var(--font-body-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif); margin:6px 0 4px; }
  .ob--pack { --selected_bg:#ffffff; --border:#dadada; --accent:#1b1b1b; --subtitle_color:#535353; --price_color:#535353; --tag_bg:#ececec; --tag_text:#111111;
    --badge_bg:#5f5f5f; --badge_text:#ffffff; --button:#1b1b1b; --radius:6px; --title_size:15px; --title_weight:500; --price_size:24px; --swatch_size:36px; }
  .ob [hidden] { display:none !important; }
  /* header, banner */
  .ob__top { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 0 8px; }
  .ob__top h2 { margin:0; font-size:var(--block_title_size); font-weight:var(--block_title_weight); color:var(--block_title_color); line-height:1.3; letter-spacing:0; }
  .ob__tname b { font-weight:600; }
  .ob__sg { display:inline-flex; align-items:center; gap:6px; padding:12px 0; margin:-12px 0; border:0; background:none; color:var(--text); font:inherit; font-size:12px; font-weight:500; text-decoration:underline; text-underline-offset:3px; cursor:pointer; }
  .ob__sg svg { width:18px; height:18px; flex:0 0 18px; }
  .ob__banner { margin:6px 0 14px; font-size:13px; line-height:1.45; color:#585858; }
  .ob--boxed .ob__banner { display:flex; align-items:center; gap:10px; margin:0 0 12px; color:var(--text); font-size:13px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
  .ob--boxed .ob__banner::before, .ob--boxed .ob__banner::after { content:""; flex:1; height:1px; background:var(--border); }
  .ob--boxed .ob__banner span { text-align:center; }
  .ob--pack .ob__banner { text-align:center; font-weight:600; color:var(--text); }
  .ob--banner-line .ob__banner { display:flex; align-items:center; gap:10px; text-transform:uppercase; letter-spacing:.04em; font-weight:600; color:var(--banner_text, var(--text)); }
  .ob--banner-line .ob__banner::before, .ob--banner-line .ob__banner::after { content:""; flex:1; height:1px; background:var(--border); }
  .ob--banner-plain .ob__banner { display:block; text-align:left; text-transform:none; letter-spacing:0; }
  .ob--banner-plain .ob__banner::before, .ob--banner-plain .ob__banner::after { display:none; }
  .ob--banner-box .ob__banner { display:flex; justify-content:center; align-items:center; gap:8px; margin:0 0 14px; padding:12px 14px; border:1.5px dashed var(--accent); border-radius:var(--radius);
    background:var(--banner_bg, var(--selected_bg)); color:var(--banner_text, var(--text)); font-size:14px; font-weight:500; text-align:center; text-transform:none; letter-spacing:0; }
  .ob--banner-box .ob__banner::before { content:""; flex:none; width:8px; height:8px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  .ob--banner-box .ob__banner::after { display:none; }
  /* bars */
  .ob__list { display:block; }
  .ob__bar { position:relative; display:block; margin-top:var(--spacing); padding:var(--bar_pad_y, 11px) var(--bar_pad_x, 14px) var(--bar_pad_b, var(--bar_pad_y, 11px)); border:1px solid var(--border); border-radius:var(--radius); background:var(--cards_bg); color:var(--text); cursor:pointer; }
  .ob__bar:first-child { margin-top:8px; }
  .ob__bar input { position:absolute; opacity:0; pointer-events:none; }
  .ob__bar.is-soldout { opacity:.5; pointer-events:none; }
  .ob__bar.is-on { border-color:var(--accent); background:var(--selected_bg); }
  .ob__row { display:flex; align-items:center; gap:var(--row_gap, 10px); min-height:var(--row_height, 32px); }
  .ob__dot { flex:0 0 var(--dot_size, 18px); width:var(--dot_size, 18px); height:var(--dot_size, 18px); border:var(--dot_border, 1.5px) solid var(--dot_color, #a1a1a1); border-radius:50%; background:#ffffff; display:grid; place-content:center; }
  .ob__dot::before { content:''; width:8px; height:8px; border-radius:50%; background:var(--accent); transform:scale(0); transition:transform .12s; }
  .is-on .ob__dot { border-color:var(--accent); }
  .is-on .ob__dot::before { transform:scale(1); }
  .ob--dot-fill .is-on .ob__dot { background:var(--accent); box-shadow:inset 0 0 0 3px #ffffff; }
  .ob--dot-fill .ob__dot::before { display:none; }
  .ob__img { flex:0 0 auto; max-width:none; object-fit:cover; background:#f4f4f4; }
  .ob__text { flex:1; min-width:0; }
  .ob__title { display:block; font-size:var(--title_size); font-weight:var(--title_weight); color:var(--title_color); line-height:1.3; }
  .ob__tag { display:inline-block; margin-left:5px; padding:var(--tag_pad_y, 3px) var(--tag_pad_x, 5px); border-radius:var(--tag_radius, 2px); box-shadow:inset 0 0 0 1px var(--tag_border, transparent); background:var(--tag_bg); color:var(--tag_text); font-size:var(--tag_size, var(--label_size)); font-weight:var(--tag_weight, var(--label_weight)); line-height:1.1; letter-spacing:.04em; text-transform:uppercase; vertical-align:2px; white-space:nowrap; }
  .ob__tag:empty { display:none; }
  .ob__sub { display:block; margin-top:2px; font-size:var(--subtitle_size); font-weight:var(--subtitle_weight); color:var(--subtitle_color); }
  .ob--italic .ob__sub, .ob--italic .ob__unit { font-style:italic; }
  .ob__unit { display:block; font-size:var(--unit_size); font-weight:var(--unit_weight); color:var(--subtitle_color); }
  .ob .ob__unit:empty { display:none; }
  .ob__save { display:inline-block; padding:var(--save_pad_y, 2px) var(--save_pad_x, 6px); border-radius:var(--save_radius, 3px); background:var(--save_bg); color:var(--save_text_color, #212121); font-size:var(--save_size, 12px); font-weight:var(--save_weight, 400); line-height:1.35; white-space:nowrap; }
  .ob__save--below { display:table; margin-top:4px; }
  .ob__save--inline { margin-left:var(--save_gap, 5px); padding:var(--save_pad_y, 2px) var(--save_pad_x, 5px); vertical-align:1px; }
  .ob__title:has(> .ob__save--inline) { display:flex; flex-wrap:wrap; align-items:center; column-gap:var(--save_gap, 5px); }
  .ob__title > .ob__save--inline { margin-left:0; }
  .ob__save--price { margin-top:2px; }
  .ob__price { display:flex; align-items:baseline; gap:5px; white-space:nowrap; text-align:right; }
  .ob__now { font-size:var(--price_size); font-weight:var(--price_weight, 600); color:var(--price_color); line-height:1.2; }
  .ob__was { order:-1; font-size:var(--strike_size, 11px); font-weight:var(--strike_weight, 400); color:var(--strike); }
  .ob__was:empty { display:none; }
  .ob__price:has(.ob__save--price) { flex-direction:column; align-items:flex-end; gap:2px; }
  .ob__badge { position:absolute; top:calc(var(--badge_top, 10px) * -1); right:12px; z-index:1; padding:3px var(--badge_pad_x, 8px); border-radius:var(--badge_radius, 4px); background:var(--badge_bg); color:var(--badge_text); font-size:var(--badge_size); font-weight:var(--badge_weight); line-height:1.2; letter-spacing:.04em; text-transform:uppercase; white-space:nowrap; pointer-events:none; }
  .ob__badge--inline { position:static; display:inline-block; margin-left:6px; padding:3px 6px; vertical-align:2px; }
  .ob__badge--foot { position:static; display:inline-block; margin-left:10px; padding:var(--badge_pad_y, 3px) var(--badge_pad_x, 7px); border-radius:var(--badge_radius, 999px); transform:none; }
  .ob__badge--ribbon { position:static; display:block; margin:-11px -14px 10px; padding:4px 14px; border-radius:0; text-align:center; }
  .ob__bar.has-badge-ribbon { overflow:hidden; }
  .ob__bar.has-badge-floating { margin-top:calc(var(--spacing) + var(--badge_space, 8px)); }
  .ob__gifts { display:flex; flex-direction:column; margin:10px -14px -11px; overflow:hidden; border-radius:0 0 var(--radius) var(--radius); }
  .ob__gift { display:flex; align-items:center; gap:10px; padding:7px 14px; background:var(--gift_bg); color:var(--gift_text); font-size:13px; font-weight:600; }
  .ob__gift + .ob__gift { border-top:1px solid rgba(0,0,0,.06); }
  .ob__gift img { max-width:none; object-fit:cover; border-radius:4px; }
  .ob__giftp { margin-left:auto; white-space:nowrap; }
  .ob__giftp s { font-weight:400; opacity:.65; }
  .ob__gsel { margin-left:auto; max-width:55%; height:28px; padding:0 8px; border:1px solid rgba(0,0,0,.18); border-radius:4px; background:#ffffff; color:#1b1b1b; font:inherit; font-size:12px; font-weight:500; }
  .ob__gsel + .ob__giftp { margin-left:8px; }
  .ob-linktier:not(.is-on) { display:none !important; }
  /* panel under the chosen bar (list, compact): continues its border */
  .ob__panel { display:flow-root; padding:2px 14px 12px; border:1px solid var(--accent); border-top:0; border-radius:0 0 var(--radius) var(--radius); background:var(--selected_bg); }
  .ob__panel:empty { display:none; }
  .ob__bar.is-on:has(+ .ob__panel:not(:empty)) { border-bottom:0; border-radius:var(--radius) var(--radius) 0 0; padding-bottom:4px; }
  .ob__bar.is-on:has(+ .ob__panel:not(:empty)) .ob__gifts { margin-bottom:4px; border-radius:var(--radius); }
  .ob__list > .ob__panel { margin-top:0; }
  /* columns / grid / pills: bars side by side, panel under all of them */
  .ob__list--columns, .ob__list--grid, .ob__list--pills { display:grid; gap:8px; margin-top:16px; }
  .ob__list--columns, .ob__list--pills { grid-template-columns:repeat(var(--n), minmax(0, 1fr)); }
  .ob__list--grid { grid-template-columns:repeat(2, minmax(0, 1fr)); row-gap:18px; }
  .ob__list--columns .ob__bar, .ob__list--grid .ob__bar, .ob__list--pills .ob__bar { margin:0 !important; padding:16px 8px 12px; text-align:center; }
  .ob__list--columns .ob__row, .ob__list--grid .ob__row, .ob__list--pills .ob__row { flex-direction:column; justify-content:flex-start; gap:6px; }
  .ob__list--columns .ob__text, .ob__list--grid .ob__text, .ob__list--pills .ob__text { flex:none; }
  .ob__list--columns .ob__save--below, .ob__list--grid .ob__save--below { margin:4px auto 0; }
  .ob__list--columns .ob__price, .ob__list--grid .ob__price { flex-direction:column; align-items:center; gap:1px; text-align:center; }
  .ob__list--columns .ob__was, .ob__list--grid .ob__was { order:1; }
  .ob__list--columns .ob__badge--floating, .ob__list--grid .ob__badge--floating { left:50%; right:auto; transform:translateX(-50%); }
  .ob__list--columns .ob__badge--ribbon, .ob__list--grid .ob__badge--ribbon { margin:-16px -8px 8px; }
  .ob__list--columns .ob__gifts, .ob__list--grid .ob__gifts { margin:8px -8px -12px; }
  .ob__list--columns .ob-cd--bar, .ob__list--grid .ob-cd--bar { position:static; margin:4px auto 0; }
  .ob--columns .ob__panel, .ob--grid .ob__panel, .ob--pills .ob__panel { margin-top:10px; padding-top:10px; border-top:1px solid var(--accent); border-radius:var(--radius); }
  .ob--pills .ob__panel { padding:0; border:0; background:none; }
  /* compact: lines, no boxes */
  .ob__list--compact .ob__bar, .ob__list--compact .ob__bar.is-on { margin:0 !important; padding:10px 2px; border:0; border-bottom:1px solid var(--border); border-radius:0 !important; background:transparent; }
  .ob__list--compact .ob__bar.has-badge-floating { padding-top:24px; }
  .ob__list--compact .ob__badge--floating { top:4px; right:0; }
  .ob__list--compact + .ob__panel, .ob__list--compact .ob__panel { border:0; border-radius:0; background:transparent; padding:4px 2px 12px; }
  .ob__list--compact .ob__gifts { margin:8px 0 0; border-radius:5px; }
  /* pills: small boxes in a row (quantity picker) */
  .ob__list--pills .ob__bar { min-height:var(--pill_h, 56px); padding:var(--pill_pad, 8px) 4px; display:flex; align-items:center; justify-content:center; line-height:1.15; }
  .ob__list--pills .ob__bar.is-on { border-width:var(--sel_border, 2px); padding:calc(var(--pill_pad, 8px) + 1px - var(--sel_border, 2px)) calc(5px - var(--sel_border, 2px)); }
  .ob__list--pills .ob__title { font-size:var(--pill_title_size, var(--title_size)); font-weight:var(--pill_weight, var(--title_weight)); line-height:var(--pill_lh, inherit); }
  .ob__list--pills .ob__sub { line-height:var(--pill_lh, inherit); }
  .ob__list--pills .ob__dot, .ob__list--pills .ob__price, .ob__list--pills .ob__unit, .ob__list--pills .ob__img { display:none; }
  .ob__list--pills .ob__row { gap:1px; min-height:0; }
  .ob__list--pills .ob__bar.is-on .ob__title { font-weight:var(--pill_on_weight, 700); }
  .ob__list--pills .ob__sub { margin:0; font-size:var(--pill_sub_size, min(var(--subtitle_size), 11.5px)); white-space:nowrap; }
  .ob__list--pills .ob__bar.is-on .ob__sub { color:var(--text); font-weight:600; }
  .ob__list--pills .ob__tag { margin:2px 0 0; }
  .ob__list--pills .ob__badge--floating { top:calc(var(--badge_top, 10px) * -1); left:var(--badge_left, 6px); right:auto; transform:none; padding:var(--badge_pad_y, 2px) var(--badge_pad_x, 7px); border-radius:var(--badge_radius, 5px); }
  .ob .ob__badge { border:var(--badge_ring_w, 0) solid var(--badge_ring, transparent); }
  .ob__list--pills .ob__badge--ribbon { margin:-8px -4px 4px; }
  .ob__list--pills .ob-hl { display:none !important; }
  .ob__hlbox:empty { display:none; }
  /* Rows (classic) */
  .ob--classic .ob__bar.is-on { align-items:flex-start; }
  .ob--classic .ob__title { font-size:var(--title_size); }
  /* Cards */
  .ob--cards .ob__bar { min-height:64px; padding:var(--bar_pad_y, 14px) var(--bar_pad_x, 16px); }
  .ob--cards .ob__bar.is-on { border-width:var(--sel_border, 2px); padding:calc(var(--bar_pad_y, 14px) + 1px - var(--sel_border, 2px)) calc(var(--bar_pad_x, 16px) + 1px - var(--sel_border, 2px)); }
  .ob--cards .ob__panel { border-width:var(--sel_border, 2px); padding:4px calc(var(--bar_pad_x, 16px) + 1px - var(--sel_border, 2px)) 14px; }
  .ob--cards .ob__bar.is-on:has(+ .ob__panel:not(:empty)) { padding-bottom:6px; }
  .ob--cards .ob__price { flex-direction:column; align-items:flex-end; gap:1px; }
  .ob--cards .ob__now { font-weight:var(--price_weight, 700); }
