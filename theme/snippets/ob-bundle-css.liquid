  .ob__dd { position:relative; min-width:0; }
  .ob__ddbtn { display:flex; align-items:center; justify-content:space-between; gap:6px; width:100%; min-width:92px; min-height:36px; padding:4px 10px; border:1px solid #dddddd; border-radius:5px; background:#ffffff; color:#1b1b1b; font:inherit; font-size:13px; font-weight:500; cursor:pointer; text-align:left; }
  .ob__ddbtn::after { content:''; flex:0 0 auto; width:6px; height:6px; margin:0 2px 3px 0; border-right:1.5px solid #797979; border-bottom:1.5px solid #797979; transform:rotate(45deg); }
  .ob__ddbtn[aria-expanded="true"] { border-color:var(--accent); }
  .ob--boxed .ob__ddbtn::after { width:0; height:0; margin:0 2px 0 0; border:0; border-left:5px solid transparent; border-right:5px solid transparent; border-top:6px solid #1b1b1b; transform:none; }
  .ob__ddbtn img { width:20px; height:26px; flex:0 0 20px; object-fit:cover; border-radius:3px; }
  .ob__ddbtn span { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .ob__dd--color .ob__ddbtn { min-width:136px; }
  .ob--cards .ob__ddbtn { min-height:var(--dd_h, 42px); border-color:var(--dd_border, #dddddd); border-radius:var(--dd_radius, 6px); color:var(--dd_text, #1b1b1b); font-size:var(--dd_size, 14px); font-weight:var(--dd_weight, 500); max-width:180px; }
  .ob__ddmenu { position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:20; min-width:100%; max-height:240px; overflow:auto; padding:4px; border:1px solid #dedede; border-radius:5px; background:#ffffff; box-shadow:0 8px 24px rgb(16 47 79 / .12); }
  .ob__ddopt { display:flex; align-items:center; gap:7px; width:100%; min-height:34px; padding:5px 6px; border:0; border-radius:3px; background:#ffffff; color:#2a2a2a; font:inherit; font-size:12px; text-align:left; cursor:pointer; }
