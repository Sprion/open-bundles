  /* shipping line between dashed lines (style ship_style dashed) */
  .ob--ship-dashed .ob__ship { justify-content:center; margin:16px 0 12px; padding:14px 0; border-top:1px dashed #cccccc; border-bottom:1px dashed #cccccc; border-radius:0; background:none; font-size:15px; color:var(--muted); }
  .ob--ship-dashed .ob__ship strong { color:var(--accent); }
  .ob__btnarrow { margin-left:auto; flex:none; vertical-align:middle; }
