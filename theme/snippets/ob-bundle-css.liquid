  .ob__summary.is-plain .ob__totals span { color:var(--text); }
  .ob__nudge { display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%; margin:12px 0 0; padding:11px 14px; border:0; border-radius:var(--radius); background:#f4f4f4; font:inherit; font-size:14px; font-weight:500; color:var(--text); text-align:left; cursor:pointer; }
