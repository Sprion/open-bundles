  .ob--boxed .ob__price { flex-direction:column; align-items:flex-end; gap:3px; }
  .ob--boxed .ob__now { font-weight:var(--price_weight, 500); }
  .ob--boxed .ob__was { order:1; font-size:14px; text-decoration:line-through; }
  .ob--boxed .ob__badge--floating { top:-11px; padding:4px 9px; letter-spacing:.05em; }
  .ob--boxed .ob__badge--ribbon { margin:-14px -14px 10px; }
