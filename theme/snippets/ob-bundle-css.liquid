  .ob__ddopt img { width:20px; height:26px; object-fit:cover; border-radius:2px; }
  .ob__ddopt:disabled { opacity:.4; text-decoration:line-through; }
  .ob__soldmsg { margin:6px 0 0; color:#494949; font-size:12px; }
  /* rows (Boxed) */
  .ob--pick-rows .ob__panel > .ob__rowshead { display:flex; justify-content:space-between; margin:12px 0 6px; padding-top:12px; border-top:1px solid rgba(0,0,0,.08); font-size:12.5px; color:var(--muted); }
  .ob__rowitem { display:grid; grid-template-columns:22px 92px 1fr; gap:8px; align-items:center; margin-top:8px; }
  .ob__rowitem > small { font-size:13px; color:var(--muted); }
  .ob__rowitem .ob__ddbtn { min-width:0; height:44px; border-color:#cccccc; border-radius:4px; font-size:14px; font-weight:400; }
  .ob__rowitem .ob__ddbtn img { width:32px; height:32px; flex-basis:32px; }
  .ob__rowitem .ob__ddopt { min-height:44px; font-size:14px; }
  .ob__rowitem .ob__ddopt img { width:36px; height:36px; }
  /* tiles (Pack) */
  .ob__sec { margin:16px 0 0; }
  .ob__lbl { display:flex; justify-content:space-between; gap:8px; margin:0 0 8px; font-size:14px; color:var(--muted); }
  .ob__lbl b { color:var(--text); font-weight:600; }
  .ob__mixes { display:flex; gap:var(--mix_gap, 8px); overflow-x:auto; padding:12px 2px 4px; scrollbar-width:none; }
  .ob__mix { position:relative; flex:0 0 var(--mix_w, 88px); height:var(--mix_h, 100px); padding:0; border:1px solid var(--border); border-radius:var(--radius); background:#f3f3f3; cursor:pointer; }
