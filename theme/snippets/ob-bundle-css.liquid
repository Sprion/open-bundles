  .ob__sheet-body { display:grid; gap:14px; padding:14px 16px 0; }
  .ob__sheet-acts { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .ob__sheet-acts button { min-height:50px; border:1px solid var(--border); border-radius:var(--radius); background:#ffffff; font:inherit; font-size:15px; font-weight:600; cursor:pointer; }
  .ob__sheet-acts [data-done] { border:0; background:var(--button); color:var(--button_text); }
  /* summary, shipping, button */
  .ob__sumprice { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin:18px 0 0; padding:0 0 10px; border-bottom:1px solid var(--border); }
  .ob__unitp { font-size:var(--unitp_size, 14px); color:var(--muted); }
  .ob__unitp b { font-size:var(--price_size); font-weight:700; color:var(--unit_price_color); }
  .ob__totals { font-size:var(--totals_size, 17px); font-weight:var(--totals_weight, 600); color:var(--price_color); white-space:nowrap; }
