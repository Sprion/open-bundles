  .ob__bar:has(> .ob-cd--bar) { margin-top:calc(var(--spacing) + 8px); }
  .ob__chips { position:absolute; top:calc(var(--chip_top, 11px) * -1); right:12px; z-index:2; display:flex; align-items:center; gap:6px; }
  .ob__tag--top { margin:0; padding:var(--chip_pad_y, 4px) var(--chip_pad_x, 9px); border-radius:var(--chip_radius, 6px); font-size:var(--chip_size, 11px); line-height:1; text-transform:none; letter-spacing:0; vertical-align:0; }
  .ob__chips .ob-cd { position:static; padding:var(--chip_pad_y, 4px) var(--chip_pad_x, 9px); border-radius:var(--chip_radius, 4px); font-size:var(--chip_size, 11px); line-height:1; }
  .ob__bar.has-chips { margin-top:calc(var(--spacing) + 10px); padding-top:var(--chips_pad, 18px); }
  .ob__bar.has-chips > .ob__badge--floating { right:auto; left:12px; transform:none; }
  .ob--price-stack .ob__price { flex-direction:column; align-items:flex-end; gap:1px; }
  .ob--price-stack .ob__was { order:1; font-size:var(--strike_size, 15px); }
  .ob--gift-line .ob__gifts { margin:var(--gift_top, 12px) 0 0; padding-top:var(--gift_pad, 10px); border-top:1px solid var(--gift_line, rgba(0,0,0,.09)); border-radius:0; overflow:visible; }
  .ob--gift-line .ob__gift { padding:0; background:none; color:var(--gift_text, var(--subtitle_color)); font-size:var(--gift_size, 13px); font-weight:var(--gift_weight, 500); line-height:1.4; gap:8px; }
  .ob--gift-line .ob__gift + .ob__gift { border:0; margin-top:6px; }
  .ob--gift-line .ob__bar.is-on .ob__gifts { margin:var(--gift_top, 12px) 0 0; border-radius:0; }
  .ob__gicon { flex:none; }
  .ob--gift-check .ob__gifts { margin:10px 0 0; padding-top:10px; border-top:1px solid var(--gift_line, rgba(0,0,0,.09)); border-radius:0; overflow:visible; }
  .ob--gift-check .ob__gift { align-items:flex-start; padding:0; background:none; color:var(--gift_text); font-size:var(--gift_size, 14px); font-weight:var(--gift_weight, 600); line-height:1.4; gap:10px; }
  .ob--gift-check .ob__gift img, .ob--gift-check .ob__gicon { display:none; }
  .ob--gift-check .ob__gift::before { content:""; flex:none; width:12px; height:6px; margin:4px 1px 0 1px; border-left:2px solid var(--highlight_icon); border-bottom:2px solid var(--highlight_icon); transform:rotate(-45deg); }
  .ob--gift-check .ob__bar.is-on .ob__gifts { margin:10px 0 0; border-radius:0; }
  .ob--gift-check .ob__gift + .ob__gift { border:0; margin-top:6px; }
  .ob.ob--gift-line .ob__bar.is-on .ob__gifts, .ob.ob--gift-check .ob__bar.is-on .ob__gifts { border-radius:0; margin-bottom:0; }
  .ob__gtext small { display:block; margin-top:1px; font-size:var(--gift_note_size, 12px); font-weight:400; color:var(--gift_note, var(--muted)); }
  /* badge looks: tab with ears, cap sitting on the border */
  .ob .ob__badge--tab { top:calc(var(--badge_top, 8px) * -1); right:calc(var(--badge_right, 10px) + var(--badge_ear, 8px)); padding:var(--badge_pad_y, 6px) var(--badge_pad_x, 8px); border-radius:0 0 var(--badge_radius, 5px) var(--badge_radius, 5px); line-height:1; text-transform:none; letter-spacing:0; }
  .ob__badge--tab::before, .ob__badge--tab::after { content:""; position:absolute; top:0; width:0; height:0; border-bottom:var(--badge_ear, 8px) solid var(--badge_bg); }
  .ob__badge--tab::before { right:100%; border-left:var(--badge_ear, 8px) solid transparent; }
  .ob__badge--tab::after { left:100%; border-right:var(--badge_ear, 8px) solid transparent; }
  .ob .ob__badge--cap { top:auto; bottom:calc(100% + 1px); right:18px; padding:5px 14px 4px; border-radius:10px 10px 0 0; text-transform:none; letter-spacing:0; }
  .ob__bar.has-badge-tab, .ob__bar.has-badge-cap { margin-top:calc(var(--spacing) + var(--badge_space, 14px)); }
  .ob .ob__bar.has-badge-tab { padding-top:calc(var(--bar_pad_y, 14px) + var(--badge_pad_in, 0px)); }
  .ob .ob__bar.has-badge-tab.is-on { padding-top:calc(var(--bar_pad_y, 14px) + 1px - var(--sel_border, 2px) + var(--badge_pad_in, 0px)); }
  /* sizes chosen once above the bars (size_first) */
  .ob__gsize { margin:0 0 16px; }
