  .ob__ship { display:flex; align-items:center; gap:10px; margin:14px 0 12px; padding:11px 14px; background:#f5f5f5; border-radius:6px; font-size:13.5px; line-height:1.35; }
  .ob__ship i { width:9px; height:9px; border-radius:50%; background:var(--ship_dot, #676767); box-shadow:0 0 0 var(--ship_halo, 4px) color-mix(in srgb, var(--ship_dot, #676767) 18%, transparent); flex:0 0 9px; }
  .ob__btnamt { margin-left:.9em; }
  .ob__cta { width:100%; min-height:var(--cta_h, 54px); border:0; border-radius:var(--cta_radius, var(--radius)); background:var(--button); color:var(--button_text); font:inherit; font-size:var(--cta_size, 15px); font-weight:var(--cta_weight, 600); letter-spacing:.06em; text-transform:uppercase; display:flex; align-items:center; justify-content:center; gap:10px; cursor:pointer; }
  .ob--pack .ob__cta { margin-top:12px; font-size:var(--cta_size, 16px); letter-spacing:0; text-transform:none; }
  .ob--pack .ob__cta svg { display:none; }
  .ob__btnwas { opacity:.6; font-weight:500; margin-right:2px; }
  .ob__btnsep { margin:0 .7em; font-weight:400; }
  .ob__btnpill { display:inline-flex; gap:6px; align-items:center; margin-left:8px; padding:6px 14px; border-radius:999px; background:rgba(255,255,255,.16); border:1px solid rgba(255,255,255,.28); }
  .ob__cta.is-missing { background:var(--cta_wait, #929292); }
  .ob__cta[disabled] { opacity:.55; cursor:not-allowed; }
  .ob__status { margin:8px 0 0; font-size:13px; color:#606060; }
  .ob__assure { display:flex; gap:14px; justify-content:center; white-space:nowrap; margin:12px 0 0; font-size:12px; color:var(--muted); }
  .ob__assure span { display:inline-flex; align-items:center; gap:6px; }
  /* shared parts: countdown, highlights, first-bar link, Gifts unlocked */
  .ob-cd { display:inline-flex; align-items:center; gap:6px; padding:4px 9px; border-radius:4px; background:var(--timer_bg); color:var(--timer_text); font-size:11px; font-weight:600; line-height:1.2; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .ob-cd b { color:var(--timer_accent); font-weight:700; }
