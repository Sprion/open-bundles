  .ob__btns { display:flex; flex-wrap:wrap; gap:8px; }
  .ob__size { min-width:44px; height:var(--size_btn_h, 44px); padding:0 10px; border:1px solid var(--border); border-radius:var(--radius); background:#ffffff; color:var(--text); font:inherit; font-size:14px; cursor:pointer; }
  .ob__size[aria-pressed=true] { border:var(--sel_border, 2px) solid var(--accent); font-weight:600; }
  .ob__size:disabled { opacity:.35; text-decoration:line-through; cursor:not-allowed; }
  .ob--pick-tiles .ob__sw { width:var(--swatch_size); height:var(--swatch_size); padding:2px; border-radius:50%; background:#ffffff; }
  .ob--pick-tiles .ob__sw span { border-radius:inherit; }
  .ob--pick-tiles .ob__sw[aria-pressed=true] { border:2px solid var(--accent); }
  /* sheet, size guide */
  .ob__dialog { width:min(560px, calc(100% - 24px)); border:0; border-radius:10px; padding:22px 18px; color:var(--text); }
  .ob__dialog::backdrop { background:rgba(16,20,24,.5); }
  .ob__dialog table { width:100%; border-collapse:collapse; font-size:12px; margin:10px 0; }
  .ob__dialog th, .ob__dialog td { padding:8px 3px; border-bottom:1px solid #e5e5e5; text-align:center; }
  .ob__dialog th { background:#f5f5f5; font-weight:600; }
  .ob__x { position:absolute; top:10px; right:10px; z-index:1; width:40px; height:40px; border:0; border-radius:50%; background:#ffffff; font-size:22px; cursor:pointer; box-shadow:0 1px 4px rgba(0,0,0,.15); }
  .ob__sheet { width:100%; max-width:520px; margin:auto auto 0; padding:0 0 16px; border-radius:16px 16px 0 0; max-height:92dvh; overflow:auto; }
  @media (min-width:750px) { .ob__sheet { margin:auto; border-radius:12px; } }
  .ob__sheet-gal { position:relative; background:#eeeeee; }
