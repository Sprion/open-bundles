  .ob__mix > span:last-child { position:absolute; left:0; right:0; bottom:3px; padding:0 4px; font-size:var(--mix_name_size, 11px); font-weight:600; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ob__mix .ob__badge { z-index:5; top:-9px; left:2px; right:auto; padding:4px 6px; border-radius:var(--mix_badge_radius, var(--badge_radius, 4px)); background:var(--mix_badge_bg, var(--badge_bg)); color:var(--mix_badge_text, var(--badge_text)); font-size:var(--mix_badge_size, var(--badge_size)); line-height:1; text-transform:none; }
  .ob__tiles { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:8px; }
  .ob__tile { position:relative; display:flex; flex-direction:column; padding:0; border:1px solid transparent; border-radius:var(--radius); background:#eeeeee; overflow:hidden; font:inherit; color:var(--text); cursor:pointer; }
