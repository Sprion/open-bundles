  .ob--cta-arrow .ob__cta > svg:first-child { display:none; }
  .ob--cta-arrow .ob__cta > span { display:flex; align-items:center; width:100%; gap:12px; font-size:16px; white-space:nowrap; }
  .ob--gifts-sel .ob__bar:not(.is-on) .ob__gifts { display:none; }
  .ob--bcase-none .ob__badge { text-transform:none; letter-spacing:0; }
  .ob--track-normal { letter-spacing:0; }
  .ob--track-tight { letter-spacing:-.02em; }
  .ob--font-system { font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
  .ob .ob__unit, .ob .ob__sub { line-height:1.4; }
  /* bar thumbnails (bar_thumbs stack) */
  .ob--thumbs .ob__dot { display:none; }
  .ob__thumbs { display:flex; align-items:flex-start; gap:max(var(--thumb_gap, 3px), 0px); flex:none; }
  .ob__thumbs > .ob__tg { position:relative; z-index:0; }
  .ob__thumbs > .ob__tplus { position:relative; z-index:1; margin-inline:min(var(--thumb_gap, 3px), 0px); }
  .ob__tg { display:flex; flex-direction:column; align-items:center; gap:4px; }
  .ob__ts { display:flex; }
  .ob__ts img { width:var(--thumb_size, 40px); height:calc(var(--thumb_size, 40px) * 1.15); object-fit:cover; border-radius:5px; background:#f1f1f1; box-shadow:0 0 0 2px var(--cards_bg); }
  .ob__bar.is-on .ob__ts img { box-shadow:0 0 0 2px var(--selected_bg); }
  .ob__ts img + img { margin-left:calc(var(--thumb_size, 40px) * -.65); }
  /* first photo in front, the next one peeking out behind it on the right */
  .ob__ts img { position:relative; }
  .ob__ts img:first-child { z-index:1; }
  .ob__tplus { align-self:flex-start; margin-top:calc(var(--thumb_size, 40px) * .38); font-size:var(--plus_size, 13px); font-weight:var(--plus_weight, 600); line-height:1; color:var(--plus_color, var(--muted)); }
  .ob__tg small { font-size:var(--thumb_cap_size, 11px); font-weight:600; line-height:var(--thumb_cap_lh, 1); color:var(--text); }
  .ob__tg small.is-free { padding:var(--free_pad_y, 3px) var(--free_pad_x, 6px); border-radius:999px; background:var(--tag_bg); color:var(--tag_text); }
  /* labelled rows (rows_labels) */
  .ob__rowshint { margin:var(--rows_hint_top, 12px) 0 4px; padding-top:var(--rows_hint_top, 12px); line-height:1.4; padding-left:var(--rows_hint_x, 0px); color:var(--rows_hint_color, var(--muted)) !important; border-top:1px solid var(--rows_line, rgba(0,0,0,.09)); text-align:var(--rows_hint_align, center); font-size:var(--rows_hint_size, 13px); color:var(--muted); }
  .ob .ob__rowitem--lab { grid-template-columns:var(--rows_num_w, 30px) minmax(0, var(--rows_color_w, 1fr)) var(--rows_size_w, 96px); justify-content:start; margin-left:var(--rows_indent, 0px); column-gap:var(--rows_col_gap, 8px); align-items:end; margin-top:var(--rows_gap, 10px); }
  .ob__rown { display:flex; flex-direction:column; align-items:center; justify-content:center; height:var(--dd_h, 46px); color:var(--rows_num_color, inherit); }
  .ob__rown b { font-size:var(--rows_num_size, 15px); font-weight:var(--rows_num_weight, 600); }
  .ob__rown em { font-size:var(--rows_free_size, 9.5px); font-style:normal; font-weight:700; letter-spacing:.04em; color:var(--rows_num_color, var(--muted)); }
  .ob__rowf { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .ob__rowf small { font-size:var(--rows_label_size, 12px); line-height:1.3; color:var(--rows_label_color, var(--muted)); }
  .ob__rowitem--lab .ob__ddbtn { height:var(--dd_h, 46px); min-height:0; border-color:var(--dd_border, #cccccc); border-radius:var(--dd_radius, 4px); background:#ffffff; font-size:var(--dd_size, 14px); }
  .ob__rowitem--lab .ob__ddbtn img { width:var(--dd_swatch, 30px); height:var(--dd_swatch, 30px); flex-basis:var(--dd_swatch, 30px); object-fit:cover; border-radius:4px; }
  .ob--gift-none .ob__gifts { display:none; }
  .ob-cd--banner { margin-left:8px; vertical-align:1px; text-transform:none; letter-spacing:0; }
  .ob .ob-hl { display:none; gap:var(--hl_gap, 6px); margin:var(--hl_top, 8px) 0 2px; color:var(--highlight_text); font-size:var(--hl_size, 14px); font-weight:400; line-height:1.35; text-align:left; }
  .ob .is-on .ob-hl, .ob .ob-hl.is-always { display:grid; }
  .ob-hl__i { display:flex; align-items:flex-start; gap:8px; }
  .ob-hl__i svg { flex:0 0 var(--hl_icon, 16px); width:var(--hl_icon, 16px); height:var(--hl_icon, 16px); margin-top:1px; color:var(--highlight_icon); }
  .ob .ob-firstlink { display:block; margin:10px auto 2px; padding:6px 4px; border:0; background:none; color:var(--link_color); font:inherit; font-size:var(--link_size, 14px); text-decoration:underline; text-underline-offset:3px; cursor:pointer; }
  .ob .ob-gl { position:relative; margin:22px 0 8px; padding:20px 12px 12px; border:1px solid var(--ladder_text); border-radius:10px; background:var(--ladder_bg); color:var(--ladder_text); }
  .ob-gl__title { position:absolute; top:-12px; left:16px; padding:3px 12px; border:1px solid var(--ladder_text); border-radius:6px; background:var(--ladder_label_bg, var(--ladder_bg)); font-size:var(--ladder_title_size, 12px); font-weight:var(--ladder_title_weight, 700); letter-spacing:.06em; text-transform:uppercase; }
  .ob-gl__row { display:flex; align-items:center; justify-content:center; gap:4px; }
  .ob-gl__plus { flex:0 0 auto; display:grid; place-items:center; width:18px; height:18px; border:1px solid currentColor; border-radius:50%; font-size:12px; line-height:1; opacity:.5; }
  .ob-gl__it { flex:1 1 0; min-width:0; display:flex; flex-direction:column; align-items:center; gap:2px; text-align:center; font-size:var(--ladder_item_size, 12px); line-height:1.25; }
  .ob-gl__pic { position:relative; display:grid; place-items:center; width:var(--ladder_pic, 56px); height:var(--ladder_pic, 56px); }
  .ob-gl__pic img { width:var(--ladder_pic, 56px); height:var(--ladder_pic, 56px); object-fit:contain; }
  .ob-gl__it s { opacity:.6; }
  .ob-gl__it b { color:var(--ladder_accent); font-weight:600; }
  .ob-gl__lock, .ob-gl__locked { display:none; }
  .ob-gl__it.is-locked .ob-gl__pic > :not(.ob-gl__lock) { opacity:.25; filter:blur(1px) grayscale(1); }
  .ob-gl__it.is-locked .ob-gl__lock { display:grid; position:absolute; inset:0; place-items:center; }
  .ob-gl__it.is-locked s, .ob-gl__it.is-locked b { filter:blur(3px); opacity:.5; }
  .ob-gl__it.is-locked .ob-gl__locked { display:block; font-size:13px; }
  /* radio looks: solid (filled), ring (thick border) */
  .ob--dot-solid .ob__dot::before, .ob--dot-ring .ob__dot::before { display:none; }
  .ob--dot-solid .is-on .ob__dot { background:var(--accent); border-color:var(--accent); }
  .ob--dot-ring .is-on .ob__dot { border-width:calc(var(--dot_size, 18px) * .3); border-color:var(--accent); background:#ffffff; }
  .ob--tagcase-none .ob__tag { text-transform:none; letter-spacing:0; }
  /* subtitle as a chip next to the title */
  .ob--sub-chip .ob__title { display:flex; flex-wrap:wrap; align-items:center; gap:6px var(--chips_gap, 8px); }
  .ob--sub-chip .ob__title .ob__tag { margin-left:0; vertical-align:0; }
  .ob .ob__sub--chip { display:inline-block; margin:0; padding:var(--tag_pad_y, 3px) var(--tag_pad_x, 5px); border-radius:var(--tag_radius, 2px); background:var(--sub_chip_bg, #f5f5f5); box-shadow:inset 0 0 0 1px var(--sub_chip_border, #d4d4d4); color:var(--subtitle_color); font-size:var(--sub_chip_size, var(--tag_size, 12px)); font-weight:var(--sub_chip_weight, 500); line-height:1.1; white-space:nowrap; }
  .ob .ob__sub--chip:empty { display:none; }
  /* price then the struck price on its right */
  .ob.ob--price-after .ob__price { flex-direction:row; align-items:baseline; gap:var(--price_strike_gap, 6px); }
  .ob.ob--price-after .ob__was { order:1; }
  /* badge as a chip on the top border, next to the top tag */
  .ob__chips .ob__badge--chip { position:static; padding:var(--chip_pad_y, 4px) var(--chip_pad_x, 9px); border-radius:var(--chip_radius, 4px); font-size:var(--chip_size, 11px); line-height:1; }
  .ob__chips .ob__tag--top:empty { display:none; }
  .ob--chipcase-upper .ob__chips > * { text-transform:uppercase; letter-spacing:.04em; }
  /* square photo swatches with an inner margin */
  .ob.ob--sw-sq .ob__sws { display:flex; flex-wrap:wrap; gap:8px; max-width:none; }
  .ob.ob--sw-sq .ob__sw { width:var(--swatch_size); height:var(--swatch_size); aspect-ratio:1 / 1; padding:var(--sw_pad, 0px); border-radius:var(--sw_radius, 8px); background:#ffffff; }
  .ob.ob--sw-sq .ob__sw span { border-radius:calc(var(--sw_radius, 8px) - var(--sw_pad, 0px)); }
  .ob--caret-tri .ob__ddbtn::after { width:0; height:0; margin:0 2px 0 0; border:0; border-left:5px solid transparent; border-right:5px solid transparent; border-top:6px solid currentColor; transform:none; }
  /* free item row: tinted line, gift icon, chip in the colour menu */
  .ob__panel { --pp:14px; }
  .ob--cards .ob__panel { --pp:calc(var(--bar_pad_x, 16px) + 1px - var(--sel_border, 2px)); }
  .ob--free-row .ob__rowitem--lab.is-free { position:relative; z-index:0; margin-top:15px; margin-bottom:7px; }
  .ob--free-row .ob__rowitem--lab.is-free::before { content:""; position:absolute; z-index:-1; top:-7px; bottom:-7px; left:calc(-1 * var(--pp) - var(--rows_indent, 0px)); right:calc(-1 * var(--pp)); background:var(--rows_free_bg, #f9f9f9); }
  .ob__rown { position:relative; }
  .ob__rown svg { position:absolute; top:50%; left:calc(-1 * var(--rows_indent, 0px) + 2px); width:20px; height:20px; margin-top:-10px; color:var(--text); }
  .ob__ddfree { flex:none; margin-left:auto; padding:3px 4px; background:var(--tag_bg); color:var(--tag_text); font-size:12px; font-style:normal; line-height:1; }
  .ob--free-row .ob__rowitem--lab { align-items:center; }
  /* gifts in a white card with a title */
  .ob.ob--gift-box .ob__gifts { display:block; margin:var(--gift_top, 14px) 0 0; padding:12px 14px; border:1px solid var(--gift_box_border, #cdcdcd); border-radius:var(--radius); background:#ffffff; overflow:visible; }
  .ob--gift-box .ob__gtitle { display:block; padding-bottom:10px; color:var(--gift_title_color, #565656); font-size:var(--gift_title_size, 15px); font-weight:var(--gift_title_weight, 700); line-height:1.3; }
  .ob.ob--gift-box .ob__gift { padding:10px 0; border-top:1px solid var(--gift_line, #e7e7e7); background:none; color:var(--gift_text, var(--text)); font-size:var(--gift_name_size, 15px); font-weight:var(--gift_name_weight, 700); gap:10px; line-height:1.3; }
  .ob.ob--gift-box .ob__gift:last-child { padding-bottom:0; }
  .ob--gift-box .ob__gift img { width:var(--gift_img, 40px) !important; height:var(--gift_img, 40px) !important; border-radius:8px; object-fit:contain; background:#ffffff; }
  .ob--gift-box .ob__giftp { display:flex; flex-direction:column; align-items:flex-end; line-height:1.25; }
  .ob--gift-box .ob__giftp s { font-size:13px; font-weight:400; color:var(--strike); opacity:1; }
  .ob--gift-box .ob__giftp b { color:var(--gift_free_color, #565656); font-size:var(--gift_name_size, 15px); font-weight:800; }
  .ob--gifts-below .ob__bar .ob__gifts { display:none !important; }
  /* link card under the bars ("Build your own pack") */
  .ob__custom { display:flex; align-items:center; gap:12px; margin:var(--spacing) 0 0; padding:10px 12px; border:1px solid var(--custom_border, var(--accent)); border-radius:8px; background:var(--custom_bg, #fbfbfb); color:var(--text); text-decoration:none; }
  .ob__cthumbs { display:flex; gap:5px; flex:none; }
  .ob__cthumbs > span { position:relative; display:grid; place-items:center; width:34px; height:44px; border:1px dashed rgba(34,34,34,.4); border-radius:4px; background:#ffffff; overflow:hidden; }
  .ob__cthumbs img { width:26px; height:35px; object-fit:cover; }
  .ob__cthumbs > span:last-child::after { content:"+"; position:absolute; inset:0; display:grid; place-items:center; background:rgba(255,255,255,.45); color:var(--text); font-size:18px; }
  .ob__ctext { flex:1; min-width:0; font-size:var(--custom_size, 15px); font-weight:var(--custom_weight, 400); line-height:1.2; }
  .ob__carrow { flex:none; display:grid; place-items:center; width:34px; height:34px; border-radius:50%; background:var(--custom_arrow_bg, var(--tag_bg)); color:var(--text); }
  /* pack link looks: card (photos + arrow), link (underlined text), button (outlined) */
  .ob--cs-link .ob__custom { justify-content:center; padding:6px 0; border:0; background:none; text-decoration:underline; text-underline-offset:3px; }
  .ob--cs-link .ob__cthumbs, .ob--cs-link .ob__carrow { display:none; }
  .ob--cs-link .ob__ctext { flex:none; text-align:center; }
  .ob--cs-button .ob__custom { justify-content:center; padding:12px 16px; }
  .ob--cs-button .ob__cthumbs { display:none; }
  .ob--cs-button .ob__ctext { flex:none; }
  .ob--cs-button .ob__carrow { width:auto; height:auto; background:none; }
  /* inline picker: size menu right after the colours, not at the end of the line */
  .ob--ilsize-after .ob__ilc { flex:none; }
  .ob__note { margin:0; padding-top:10px; color:var(--note_color, var(--muted)); font-size:var(--note_size, 12px); line-height:1.4; }
  /* shipping line looks: plain (centred dot + text), caps (small capitals under the button) */
  .ob--ship-plain .ob__ship { justify-content:center; gap:8px; margin:12px 0; padding:0; border-radius:0; background:none; font-size:var(--ship_size, 15px); }
  .ob--ship-plain .ob__ship strong { color:var(--ship_strong, var(--accent)); font-weight:400; }
  .ob--ship-caps .ob__ship { justify-content:center; margin:16px 0 0; padding:0; border-radius:0; background:none; font-size:var(--ship_size, 11px); line-height:1.4; text-align:center; text-transform:uppercase; }
  .ob--ship-caps .ob__ship i { display:none; }
  .ob--ship-caps .ob__ship strong { color:var(--ship_strong, inherit); font-weight:800; }
  .ob.ob--after { margin:0; }
  /* ticket banner above the title; its number follows the selected bar */
  .ob__ticket { position:relative; display:flex; margin:0 0 24px; border:1px solid var(--ticket_bg, #1b1b1b); border-radius:12px; background:var(--ticket_bg, #1b1b1b); color:var(--ticket_text, #ffffff); }
  .ob__ticket::before, .ob__ticket::after { content:""; position:absolute; left:67px; width:18px; height:9px; background:#ffffff; border:1px solid var(--ticket_bg, #1b1b1b); }
  .ob__ticket::before { top:-1px; border-top:0; border-radius:0 0 18px 18px; }
  .ob__ticket::after { bottom:-1px; border-bottom:0; border-radius:18px 18px 0 0; }
  .ob__tstub { flex:0 0 76px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; border-right:1px dashed rgba(34,34,34,.35); border-radius:11px 0 0 11px; background:var(--ticket_stub_bg, #e5e5e5); color:var(--ticket_stub_text, #1b1b1b); }
  .ob__tstub b { font-size:28px; font-weight:700; line-height:1; letter-spacing:-.02em; }
  .ob__tstub small { font-size:9px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .ob__tbody { flex:1; display:flex; flex-direction:column; gap:7px; padding:13px 14px; }
  .ob__tbody em svg { margin-right:6px; vertical-align:-3px; }
  .ob__tbody em { font-style:normal; font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--ticket_accent, #e5e5e5); }
  .ob__tbody > span { font-size:14px; line-height:1.4; }
  .ob__tbody strong { color:var(--ticket_accent, #e5e5e5); font-weight:700; }
  /* Build your own pack: pop-up sheet on the product page (size, + / - per colour, per-item price, progress) */
  .ob__pb { display:none; padding:0; }
  .ob__pb[open] { display:flex; flex-direction:column; max-height:min(92dvh, 760px); overflow:hidden; }
  .ob__pbhead { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px 18px 12px; border-bottom:1px solid #eeeeee; }
  .ob__pbhead b { font-size:17px; font-weight:600; }
  .ob__pbx { display:grid; place-items:center; width:36px; height:36px; padding:0; border:0; border-radius:50%; background:#f3f3f3; color:var(--text); font-size:22px; line-height:1; cursor:pointer; }
  .ob__pbbody { flex:1; min-height:0; overflow:auto; padding:6px 18px 16px; }
  .ob__pbstep { margin:14px 0 10px; font-size:14px; font-weight:600; color:var(--text); }
  .ob__pb .ob__btns { display:grid; grid-template-columns:repeat(auto-fill, minmax(52px, 1fr)); gap:8px; }
  .ob__pb .ob__size[aria-pressed="true"] { border-color:var(--accent); box-shadow:inset 0 0 0 1px var(--accent); font-weight:600; }
  .ob__pbcols { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:10px; }
  .ob__pbc { display:flex; flex-direction:column; gap:6px; min-width:0; }
  .ob__pbimg { position:relative; display:block; aspect-ratio:3 / 4; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius); background:#f5f5f5; }
  .ob__pbc.is-on .ob__pbimg { border-color:var(--accent); box-shadow:inset 0 0 0 1px var(--accent); }
  .ob__pbc.is-out { opacity:.4; }
  .ob__pbimg img { width:100%; height:100%; object-fit:cover; }
  .ob__pbimg i { position:absolute; top:6px; right:6px; display:grid; place-items:center; min-width:22px; height:22px; padding:0 6px; border-radius:11px; background:var(--accent); color:#ffffff; font-size:12px; font-style:normal; font-weight:700; }
  .ob__pbname { overflow:hidden; font-size:13px; text-overflow:ellipsis; white-space:nowrap; }
  .ob__pbq { display:grid; grid-template-columns:32px 1fr 32px; align-items:center; height:34px; border:1px solid var(--border); border-radius:var(--radius); background:#ffffff; }
  .ob__pbq button { height:100%; padding:0; border:0; background:none; color:var(--text); font-size:18px; cursor:pointer; }
  .ob__pbq button:disabled { opacity:.3; cursor:default; }
  .ob__pbq b { text-align:center; font-size:14px; font-weight:600; }
  .ob__pbfoot { display:grid; gap:8px; padding:12px 18px 18px; border-top:1px solid #eeeeee; background:#ffffff; }
  .ob__pbcount { display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px 10px; margin:0; font-size:13px; }
  .ob__pbcount span { font-weight:600; }
  .ob__pbcount em { font-style:normal; color:var(--pb_hint, var(--accent)); }
  .ob__pbbar { height:6px; overflow:hidden; border-radius:3px; background:#eeeeee; }
