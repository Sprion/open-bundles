  .ob__label { display:block; margin:0 0 6px; font-size:12px; font-weight:500; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ob--cards .ob__label { font-size:13px; }
  .ob__label b { font-weight:var(--label_value_weight, 400); color:var(--label_value_color, #585858); }
