{% doc %}
  Add to cart button of a editor bundle (component of ob-bundle), used when the page has no Add to cart block of its
  own. ob-bundle.js writes its label ("Add 2 items to cart · $199.90", "Choose your options", "Sold out").
  @param {string} [label] - Default label.
  @param {string} [assure_1] - First assurance line under the button.
  @param {string} [assure_2] - Second assurance line.
{% enddoc %}
<button type="button" class="ob__cta" data-ob-cta><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L21 8H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg><span data-ob-cta-label>{{ label | default: 'Add to cart' }}</span></button>
<p class="ob__status" data-ob-status role="status" aria-live="polite" hidden></p>
{%- if assure_1 != blank or assure_2 != blank -%}
<div class="ob__assure">
  {%- if assure_1 != blank -%}<span><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7L12 17.5 5.8 21.2l1.6-7L2 9.5l7.1-.6z"/></svg>{{ assure_1 }}</span>{%- endif -%}
  {%- if assure_2 != blank -%}<span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6z"/></svg>{{ assure_2 }}</span>{%- endif -%}
</div>
{%- endif -%}
